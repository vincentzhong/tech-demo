# Environment Variables for Local Development
# Copy this file to .env and update with your values
# .env is gitignored and will not be committed

# Demo User Credentials (format: username:password)
ADMIN_USER=admin:your-secure-admin-password
DEMO_USER=demo:your-demo-password

# JWT Secret (minimum 32 characters, recommend 64+)
JWT_SECRET=your-cryptographically-random-secret-min-64-chars-recommended

# Database Connection (for local development without Docker)
# CONNECTION_STRING=Server=localhost;Database=Bookstore;Uid=root;Pwd=password;Port=3306;

# Notes:
# - For Docker Compose: You can optionally set ADMIN_USER and DEMO_USER
# - If not set, defaults will be used (admin:devpassword, demo:demo123)
# - For production: Set these in GitHub Secrets, not in .env files
